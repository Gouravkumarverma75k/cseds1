<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FURNITURES</title>
    <style>
        body {
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            background-color: rgb(21, 199, 196);
            box-sizing: border-box;
        }

        h2 {
            text-align: center;
            margin: 20px 0;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            padding: 20px;
            box-sizing: border-box;
        }

        .card {
            background-color: #fff;
            padding: 20px;
            box-sizing: border-box;
        }

        .card img {
            width: 80%;
            height: 200px;
            object-fit: cover;
            margin-bottom: 15px;
        }

        .card h3 {
            margin: 0;
            font-size: 18px;
            margin-bottom: 10px;
        }

        .card p {
            margin: 0;
            font-size: 14px;
            color: #910e8a;
            margin-bottom: 10px;
        }

       

        .price {
            font-weight: bold;
            color: #16af8e;
        }

        @media (max-width: 1024px) {
            .grid {
                grid-template-columns: repeat(2, 1fr);

            }

            @media(max-width: 600px) {
                .grid {
                    grid-template-columns: repeat(1, 1fr);
                }
            }
        }
    </style>
</head>

<body>
    <h2>FURNITURES</h2>
    <div class="grid">
        <div class="card">
            
            <img src="data:image/jpeg;base64," alt="Product 1">

            
            <h3>Product 1</h3>
            <i>
            <p>High-quality item with great features.</p>
            </i>
            <p class="price">₹499</p>
        </div>
        <div class="card">
           
            <img src="data:image/jpeg;base64," alt="Product 2">
            <h3>Product 2</h3>
            <i>
            <p>comforatable and durable.</p>
        </i>
            <p class="price">₹699</p>
        </div>
        <div class="card">
           
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRVLGeiOMaOiE_AgCzVZuaNaQgizRHTxSmsoQ&s" alt="Product 3">
            <h3>Product 3</h3>
            <i>
            <p>exacellent product and its material</p>
        </i>
            <p class="price">₹1399</p>
        </div>
        <div class="card">
            
            <img src="https://ik.imagekit.io/2xkwa8s1i/img/npl_modified_images/SOFA_IMAGES/WSFAHAVN3FMCB_LS_1.jpg?tr=w-3840" alt="Product 4">
            <h3>Product 4 </h3>
            <i>
            <p>Trendy design with premium quality.</p></i>
            <p class="price">₹999</p>
        </div>
    </div>
</body>

</html>
